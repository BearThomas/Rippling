{
  // 旧地址的"搬家公告"：只做一件事 —— 告诉来的人新站在哪，然后把人送过去
  // 用法：npx wrangler deploy --config wrangler.announce.jsonc
  // 同一个目录（announce/）也作为 Pages 项目 lg-announce 的静态资源
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lg-moved",
  "compatibility_date": "2025-07-18",

  // 纯静态：没有 main，Worker 只负责把 announce/ 里的文件发出去
  "assets": {
    "directory": "./announce",
    "not_found_handling": "single-page-application"
  },

  // 老学生收藏的就是这个地址（原来的 Worker 站），现在让它当"门房"
  "routes": [
    { "pattern": "rippling.618271.xyz", "custom_domain": true },
    // 根域也归门房管：直接输 618271.xyz 的人原来看到的是 522（DNS 有个指向 192.0.2.1 的
    // 代理记录），不如给张纸条。根域的 A 记录是"外部托管"的，Custom Domain 会被拒绝
    // （code 100117），所以这里用普通 Route —— Route 不需要动 DNS，且优先于回源
    { "pattern": "618271.xyz/*", "zone_name": "618271.xyz" },
    { "pattern": "www.618271.xyz/*", "zone_name": "618271.xyz" }
  ]
}
