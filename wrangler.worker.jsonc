{
  // 测试 Worker 的配置（独立于 Pages 的 wrangler.toml）
  // 用法：npx wrangler deploy --config wrangler.worker.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rippling-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源：public/ 就是 vite build 的输出目录
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // D1：先连测试库，切生产时只改这一处
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rippling-worker-test",
      "database_id": "4631325c-84b7-4344-b944-e4e22c275086"
    }
  ],

  // workers.dev 保留（国内不可达，但本地/隧道里调试方便，也是旧链接的兜底）
  "workers_dev": true,

  // 自定义域名：workers.dev 在国内基本不可达（共享域名），用自己的域名才行
  // 这是 Custom Domain（不是普通 Route），Cloudflare 会自动建 DNS 记录并签发证书
  "routes": [{ "pattern": "rippling.618271.xyz", "custom_domain": true }],

  "observability": { "enabled": true }
}
